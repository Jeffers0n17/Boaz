# ==== AXIA backend - variáveis de ambiente ====
# Copie este arquivo para .env e preencha o que quiser ativar em modo "real".
# Tudo que ficar em branco roda automaticamente em modo DEMO (sem chamar
# nenhuma API externa) — o app funciona igual, só que com dados/fluxos simulados.

# Porta do servidor HTTP (backend + frontend estático)
PORT=8080

# Segredo usado para assinar os tokens JWT de sessão. Em produção, use um
# valor longo e aleatório. Se deixar em branco, um valor de desenvolvimento
# fixo é usado (NÃO use isso em produção).
JWT_SECRET=

# ---- Chat com IA (Claude / Anthropic) ----
# OBRIGATÓRIA para o assistente responder de verdade usando IA.
# Sem ela, o chat funciona em modo demo (respostas por regras sobre os
# dados mockados do usuário: tarefas, lembretes, eventos, transações).
# Gere a sua em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---- Stripe (billing) ----
# Sem isso, POST /api/billing/create-checkout-session cria uma sessão demo
# local (não chama a Stripe de verdade).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# ---- Google Calendar (OAuth) ----
# Sem isso, GET /api/integrations/google/auth retorna um fluxo demo
# (conta "conectada" com eventos mockados, sem OAuth real).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/integrations/google/callback

# ---- WhatsApp ----
# A integração usa whatsapp-web.js (biblioteca real, baseada em navegador
# headless) e não precisa de chave de API — mas precisa de um número de
# WhatsApp real escaneando o QR code gerado em
# GET /api/integrations/whatsapp/qr para ficar "conectada" de verdade.
# ENABLE_WHATSAPP=false desliga completamente a inicialização do cliente.
ENABLE_WHATSAPP=true
WHATSAPP_CHROMIUM_PATH=

# ---- ElevenLabs (texto-para-voz) ----
# Usado pelo assistente de voz em Python e pelo endpoint opcional /api/tts.
# Sem isso, o assistente de voz cai para TTS local offline (pyttsx3).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
